# Groq key (free, no card): https://console.groq.com/keys
GROQ_API_KEY=
# Cloudflare Workers AI (free, no card): dash.cloudflare.com > Workers AI > Use REST API
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
# Optional: check each reply with a small model before it is shown (quality pass, spec 4.5).
# Off by default. It lowered invented details but also the hit rate, and slowed the first reply; see eval/RESULTS.md.
# CLAIM_CHECK=on
